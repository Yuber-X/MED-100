<UserControl x:Class="MED100.Views.CitasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="400" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Barra del día =====
         Dos filas y no una: en una sola, los botones de la derecha (fijos) y
         la navegación de la izquierda (que no se encoge) se pisaban entre sí
         al achicar la ventana, y el combo de médico terminaba debajo del botón
         de recordatorios (reportado 2026-08-14). Ahora cada grupo tiene su
         renglón y ninguno depende del ancho del otro. -->
    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="12" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Las flechas son PATH, no los glifos ◀ ▶ (reportado 2026-08-14: "se
             ven uno grande y otro pequeño, y el de la derecha cortado"). Esos
             caracteres no están en la fuente de la interfaz, así que Windows
             los saca de donde puede —cada uno de una fuente distinta— y salen
             de tamaños diferentes y a veces recortados. Dibujados, las dos son
             la misma geometría espejada: idénticas por construcción. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button Width="40" Style="{DynamicResource Boton.Secundario}"
                  ToolTip="Día anterior"
                  Command="{Binding DiaAnteriorCommand}">
            <Path Data="M 5,0 L 0,4.5 L 5,9" Width="6" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Button>
          <Button Content="Hoy" Width="70" Margin="8,0" Style="{DynamicResource Boton.Secundario}"
                  Command="{Binding HoyCommand}" />
          <Button Width="40" Style="{DynamicResource Boton.Secundario}"
                  ToolTip="Día siguiente"
                  Command="{Binding DiaSiguienteCommand}">
            <Path Data="M 0,0 L 5,4.5 L 0,9" Width="6" Height="10" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />
          </Button>
          <DatePicker Width="150" Margin="12,0,0,0"
                      SelectedDate="{Binding Dia, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Enviar recordatorios" Margin="0,0,10,0"
                  Style="{DynamicResource Boton.Secundario}"
                  Command="{Binding EnviarRecordatoriosCommand}"
                  ToolTip="Manda por correo los avisos pendientes de las próximas horas" />
          <Button Content="Nueva cita"
                  Style="{DynamicResource Boton.Primario}"
                  Command="{Binding NuevaCommand}" />
        </StackPanel>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="Ver la agenda de" VerticalAlignment="Center"
                   Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoSecundario}" />
        <ComboBox Width="230" Margin="10,0,0,0"
                  ItemsSource="{Binding MedicosFiltro}"
                  SelectedItem="{Binding MedicoFiltro, Mode=TwoWay}"
                  ItemTemplate="{DynamicResource Combo.Nombre}" />
      </StackPanel>

      <TextBlock Text="{Binding DiaTexto}" Style="{DynamicResource Texto.Titulo3}" Margin="2,12,0,0" />
      <TextBlock Text="{Binding Resumen}" Style="{DynamicResource Texto.Caption}"
                 Foreground="{DynamicResource Brush.TextoSecundario}" Margin="2,4,0,0" />
    </StackPanel>

    <!-- ===== Agenda del día ===== -->
    <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Citas}"
                SelectedItem="{Binding Seleccionada}"
                Style="{DynamicResource Tabla}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Hora" Binding="{Binding RangoTexto}" Width="Auto" MinWidth="160" />
          <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente}" Width="*" MinWidth="140"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Teléfono" Binding="{Binding TelefonoTexto}" Width="Auto" MinWidth="120" />
          <DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="Auto" MinWidth="170"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoTexto}" Width="Auto" MinWidth="160"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <!-- Lo primero que se mira cuando alguien dice "nadie me avisó" -->
          <DataGridTextColumn Header="Recordatorio" Binding="{Binding RecordatorioTexto}" Width="Auto" MinWidth="150">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextoTerciario}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RecordatorioEnviado}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Estado" Width="110">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                  <Border.Style>
                    <Style TargetType="Border">
                      <!-- Cancelada / no asistió: apagadas, ya no ocupan la agenda -->
                      <Setter Property="Background" Value="{DynamicResource Brush.Cancelado.Fondo}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding OcupaAgenda}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.AlDia.Fondo}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Cancelado.Texto}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding OcupaAgenda}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- ===== Panel derecho ===== -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
            Style="{DynamicResource Card}" Padding="20,20,8,20">
      <Grid>

        <!-- ===== Formulario ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                      Visibility="{Binding Editando, Converter={StaticResource BoolAVisibilidad}}">
          <StackPanel>
            <TextBlock Text="Cita" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,14" />

            <!-- El combo lista los pacientes ya registrados; la caja de arriba
                 solo acota cuando son muchos. -->
            <TextBlock Text="Paciente" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding BusquedaPaciente, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="Escribí nombre, cédula o teléfono para acotar la lista de abajo" />
            <ComboBox Margin="0,8,0,0"
                      ItemsSource="{Binding PacientesSugeridos}"
                      SelectedItem="{Binding PacienteSeleccionado, Mode=TwoWay}"
                      ItemTemplate="{DynamicResource Combo.Nombre}" />
            <TextBlock Text="{Binding MensajePacientes}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}" Margin="2,4,0,0" />

            <!-- Solo los médicos que atienden el día elegido: ofrecer a alguien
                 que ese día no viene lleva a un combo de horas vacío sin
                 explicación. -->
            <TextBlock Text="Médico" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding MedicosForm}"
                      SelectedItem="{Binding MedicoForm, Mode=TwoWay}"
                      ItemTemplate="{DynamicResource Combo.Nombre}" />
            <TextBlock Text="{Binding MensajeMedicos}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.Destructivo}" Margin="2,4,0,0" />

            <TextBlock Text="Motivo" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding Procedimientos}"
                      SelectedItem="{Binding ProcedimientoForm, Mode=TwoWay}"
                      ItemTemplate="{DynamicResource Combo.Nombre}" />

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Día" Style="{DynamicResource Input.Label}" />
                <DatePicker SelectedDate="{Binding DiaForm, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Duración (min)" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding DuracionTexto, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
              </StackPanel>
            </Grid>

            <!-- Se ofrecen los huecos en vez de hacer adivinar una hora -->
            <TextBlock Text="Hora disponible" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
            <ComboBox ItemsSource="{Binding Huecos}"
                      SelectedItem="{Binding HuecoSeleccionado, Mode=TwoWay}"
                      ItemTemplate="{DynamicResource Combo.HoraTexto}" />
            <TextBlock Text="{Binding MensajeHuecos}" TextWrapping="Wrap"
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}" Margin="2,6,0,0" />

            <TextBlock Text="Notas (opcional)" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
            <TextBox Style="{DynamicResource Input.Texto}" Height="60"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="10,8"
                     Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock TextWrapping="Wrap" Margin="2,4,0,0"
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}"
                       Text="Notas de recepción. Acá NO van diagnósticos ni tratamientos." />

            <TextBlock Text="{Binding MensajeError}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource Brush.Destructivo}"
                       Style="{DynamicResource Texto.Caption}" />

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                      Command="{Binding CancelarCommand}" />
              <Button Grid.Column="2" Content="Guardar" Style="{DynamicResource Boton.Primario}"
                      Command="{Binding GuardarCommand}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Ficha ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                      Visibility="{Binding Editando, Converter={StaticResource InversorBoolVisibilidad}}">
          <StackPanel>
            <TextBlock Text="Elegí una cita de la lista para ver sus opciones."
                       TextWrapping="Wrap" Style="{DynamicResource Texto.Cuerpo}"
                       Foreground="{DynamicResource Brush.TextoSecundario}"
                       Visibility="{Binding HaySeleccion,
                                    Converter={StaticResource InversorBoolVisibilidad}}" />

            <StackPanel Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="{Binding Seleccionada.Paciente}" TextWrapping="Wrap"
                         Style="{DynamicResource Texto.Titulo3}" />
              <TextBlock Text="{Binding Seleccionada.RangoTexto}"
                         Style="{DynamicResource Texto.Monto}" Margin="0,6,0,0" />

              <TextBlock Text="{Binding Seleccionada.Medico}" Margin="0,12,0,0"
                         Style="{DynamicResource Texto.Cuerpo}" />
              <TextBlock Text="{Binding Seleccionada.MotivoTexto}"
                         Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoSecundario}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding Seleccionada.TelefonoTexto}"
                         Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoSecundario}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding Seleccionada.RecordatorioTexto}"
                         Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoSecundario}" Margin="0,10,0,0" />

              <!-- Cambios de estado: solo los que tienen sentido desde el actual -->
              <TextBlock Text="Marcar como" Style="{DynamicResource Input.Label}" Margin="0,18,0,6" />
              <ItemsControl ItemsSource="{Binding EstadosDisponibles}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Etiqueta}" Margin="0,0,0,8"
                            HorizontalAlignment="Stretch"
                            Style="{DynamicResource Boton.Secundario}"
                            Command="{Binding DataContext.CambiarEstadoCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Esta cita ya terminó: su estado no se cambia más."
                         TextWrapping="Wrap" Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoTerciario}"
                         Visibility="{Binding PuedeCambiarEstado,
                                      Converter={StaticResource InversorBoolVisibilidad}}" />

              <!-- Camino corto de la agenda a la caja: lleva el paciente, el
                   médico y el procedimiento ya cargados -->
              <Button Content="Cobrar esta cita" Margin="0,18,0,0"
                      Style="{DynamicResource Boton.Primario}"
                      Command="{Binding CobrarCommand}" />

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reprogramar" Style="{DynamicResource Boton.Secundario}"
                        Command="{Binding EditarCommand}" />
                <Button Grid.Column="2" Content="Eliminar" Style="{DynamicResource Boton.Destructivo}"
                        Command="{Binding EliminarCommand}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
