<Window x:Class="MED100.Views.EscanearCedulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escanear cédula"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Escanear cédula" Style="{DynamicResource Texto.Titulo3}" />
      <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Podés pasar la cédula por el lector USB, usar la cámara o abrir una foto. Antes de llenar la ficha vas a ver lo que se leyó." />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="380" />
      </Grid.ColumnDefinitions>

      <!-- ===== Cámara ===== -->
      <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#111111" CornerRadius="8">
            <Grid>
              <Image x:Name="Vista" Stretch="Uniform" Margin="6" />
              <TextBlock x:Name="AvisoCamara" Foreground="#DDDDDD" TextWrapping="Wrap"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" MaxWidth="320" FontSize="12.5"
                         Text="La cámara está apagada.&#10;Encendela para leer el código de la cédula." />
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BotonCamara" Content="Encender la cámara"
                    Style="{DynamicResource Boton.Secundario}"
                    Click="BotonCamara_Click" />
            <Button Content="Leer desde una foto" Margin="10,0,0,0"
                    Style="{DynamicResource Boton.Secundario}"
                    Click="BotonFoto_Click"
                    ToolTip="Si la cámara no enfoca, sirve una foto del reverso de la cédula" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Lector USB y resultado ===== -->
      <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="16">
        <StackPanel>
          <TextBlock Text="Lector USB" Style="{DynamicResource Input.Label}" />
          <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Text="Hacé clic acá y pasá la cédula: el lector escribe solo." />
          <TextBox x:Name="CajaLector" Style="{DynamicResource Input.Texto}" Margin="0,6,0,0"
                   KeyDown="CajaLector_KeyDown" />
          <Button Content="Leer lo escrito" Margin="0,8,0,0" HorizontalAlignment="Left"
                  Style="{DynamicResource Boton.Secundario}"
                  Click="BotonLeer_Click" />

          <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10"
                  Padding="14" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="LO QUE SE LEYÓ" Style="{DynamicResource Texto.Caption}" />
              <TextBlock x:Name="TextoCedula" Style="{DynamicResource Texto.Cuerpo}"
                         Margin="0,6,0,0" Text="—" />
              <TextBlock x:Name="TextoNombre" Style="{DynamicResource Texto.Caption}"
                         TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock x:Name="TextoOtros" Style="{DynamicResource Texto.Caption}"
                         TextWrapping="Wrap" Margin="0,2,0,0" />
              <TextBlock x:Name="TextoCrudo" Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoTerciario}"
                         TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== Acciones ===== -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
              IsCancel="True" Click="BotonCancelar_Click" />
      <Button x:Name="BotonUsar" Content="Usar estos datos" Margin="10,0,0,0"
              Style="{DynamicResource Boton.Primario}" IsEnabled="False"
              Click="BotonUsar_Click" />
    </StackPanel>
  </Grid>
</Window>
