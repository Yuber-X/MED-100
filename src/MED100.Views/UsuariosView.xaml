<UserControl x:Class="MED100.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <!-- ===== LISTA (se oculta mientras el formulario está abierto) ===== -->
    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding FormularioVisible}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,16">
        <Button DockPanel.Dock="Right" Content="+ Nuevo usuario"
                Style="{DynamicResource Boton.Primario}"
                Command="{Binding NuevoCommand}" />
        <TextBlock Text="Solo el Administrador puede crear empleados, cambiar sus contraseñas y ajustar sus permisos."
                   Style="{DynamicResource Texto.Caption}" VerticalAlignment="Center" />
      </DockPanel>

      <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
        <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="Auto" MinWidth="160"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCompleto}" Width="*" MinWidth="150"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            <DataGridTextColumn Header="Rol" Binding="{Binding RolTexto}" Width="Auto" MinWidth="130" />
            <DataGridTextColumn Header="Último acceso" Binding="{Binding UltimoAccesoTexto}" Width="Auto" MinWidth="160" />
            <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="100" />
            <DataGridTemplateColumn Width="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="Editar" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.EditarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <TextBlock Grid.Row="2" Text="{Binding MensajeExito}"
                 Foreground="{DynamicResource Brush.DeltaPositivo}"
                 Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
    </Grid>

    <!-- ===== FORMULARIO ===== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                  Visibility="{Binding FormularioVisible, Converter={StaticResource BoolAVisibilidad}}">
      <StackPanel MaxWidth="820" HorizontalAlignment="Left">

        <Border Style="{DynamicResource Card}" Padding="24" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="{Binding TituloFormulario}" Style="{DynamicResource Texto.Titulo3}"
                       Margin="0,0,0,16" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Apellido" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Nombre de usuario (para entrar)" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Rol" Style="{DynamicResource Input.Label}" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding RolSeleccionado}" />
              </StackPanel>
            </Grid>

            <!-- Qué hace el rol elegido: "Servicio" no se entiende por el
                 nombre, y las casillas de abajo son demasiada letra chica
                 para contestar "¿este puede cobrar?". -->
            <TextBlock Text="{Binding DescripcionRol}" TextWrapping="Wrap" Margin="2,8,0,0"
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}" />

            <TextBlock Margin="0,14,0,6">
              <TextBlock.Style>
                <!-- Al crear: contraseña obligatoria. Al editar: opcional
                     (el Admin la cambia solo si el empleado la olvidó). -->
                <Style TargetType="TextBlock" BasedOn="{StaticResource Input.Label}">
                  <Setter Property="Text" Value="Nueva contraseña (dejar vacío para no cambiarla)" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                      <Setter Property="Text" Value="Contraseña (mínimo 8 caracteres)" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <PasswordBox x:Name="CajaPassword" Style="{DynamicResource Input.Password}"
                         PasswordChanged="CajaPassword_PasswordChanged" />

            <!-- Solo al editar: un usuario nuevo siempre nace activo -->
            <CheckBox Content="Usuario activo (puede iniciar sesión)" IsChecked="{Binding Activo}"
                      FontSize="13" Margin="0,16,0,0"
                      Foreground="{DynamicResource Brush.TextoPrincipal}">
              <CheckBox.Style>
                <Style TargetType="CheckBox">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EsNuevo}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </CheckBox.Style>
            </CheckBox>
          </StackPanel>
        </Border>

        <!-- Permisos -->
        <Border Style="{DynamicResource Card}" Padding="24" Margin="0,0,0,16">
          <StackPanel>
            <DockPanel Margin="0,0,0,4">
              <Button DockPanel.Dock="Right" Content="Restablecer a los del rol"
                      Style="{DynamicResource Boton.Terciario}"
                      Command="{Binding RestablecerPermisosCommand}" />
              <TextBlock Text="Permisos" Style="{DynamicResource Texto.Titulo3}" />
            </DockPanel>
            <TextBlock Text="El rol asigna los permisos por defecto. Marca o desmarca para ajustar qué puede hacer este empleado (por ejemplo, quitarle editar o eliminar productos y clientes)."
                       Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />

            <ItemsControl ItemsSource="{Binding Permisos}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox IsChecked="{Binding Asignado}" Margin="0,0,16,12"
                            FontSize="13" Foreground="{DynamicResource Brush.TextoPrincipal}">
                    <StackPanel>
                      <TextBlock Text="{Binding Nombre}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                      <TextBlock Text="{Binding PistaTexto}" Style="{DynamicResource Texto.Caption}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding MensajeError}"
                   Foreground="{DynamicResource Brush.Destructivo}"
                   Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="4,0,0,0" />
        <TextBlock Text="{Binding MensajeExito}"
                   Foreground="{DynamicResource Brush.DeltaPositivo}"
                   Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="4,0,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,16,0,24">
          <Button Content="Guardar usuario" Style="{DynamicResource Boton.Primario}"
                  Command="{Binding GuardarCommand}"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
          <Button Content="Cancelar" Style="{DynamicResource Boton.Secundario}" Margin="12,0,0,0"
                  Command="{Binding CancelarCommand}" Click="BotonCancelar_Click" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
