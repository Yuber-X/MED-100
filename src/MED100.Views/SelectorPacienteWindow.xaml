<Window x:Class="MED100.Views.SelectorPacienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar paciente"
        Width="720" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/MED100.Views;component/Assets/med100.ico"
        Background="{DynamicResource Brush.FondoApp}">

  <!-- Pedido de la clínica (2026-09-21): "CITA: DEBE ESTAR EL BOTON QUE JALE
       LOS PACIENTES PARA DESDE ESE MODULO PODER AGENDAR UN PACIENTE".
       El combo del formulario muestra los primeros 50; acá está la lista
       entera, con buscador y los datos que sirven para reconocer a alguien
       cuando hay dos con el mismo nombre. -->
  <Border Margin="18" Style="{DynamicResource Card}" Padding="18">
    <DockPanel>

      <StackPanel DockPanel.Dock="Top">
        <TextBlock Text="Buscar paciente" Style="{DynamicResource Texto.Titulo3}" />
        <TextBox x:Name="CajaBusqueda" Style="{DynamicResource Input.Texto}" Margin="0,12,0,0"
                 TextChanged="Busqueda_TextChanged"
                 ToolTip="Nombre, cédula o teléfono" />
        <TextBlock x:Name="TextoResumen" Style="{DynamicResource Texto.Caption}" Margin="2,6,0,10" />
      </StackPanel>

      <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Style="{DynamicResource Texto.Caption}"
                   Text="Doble clic en el paciente para elegirlo." />
        <Button Grid.Column="1" Content="Cancelar" MinWidth="110"
                Style="{DynamicResource Boton.Secundario}" IsCancel="True" />
        <Button Grid.Column="3" x:Name="BotonElegir" Content="Elegir" MinWidth="130"
                Style="{DynamicResource Boton.Primario}" IsDefault="True"
                Click="Elegir_Click" />
      </Grid>

      <DataGrid x:Name="Lista" Style="{DynamicResource Tabla}"
                MouseDoubleClick="Lista_MouseDoubleClick"
                SelectionChanged="Lista_SelectionChanged">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Paciente" Binding="{Binding Nombre}" Width="*" MinWidth="200" />
          <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="Auto" MinWidth="120" />
          <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto" MinWidth="110" />
        </DataGrid.Columns>
      </DataGrid>

    </DockPanel>
  </Border>
</Window>
