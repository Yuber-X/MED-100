<UserControl x:Class="MED100.Views.PacienteFichaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- Etiqueta gris arriba, valor abajo. Se repite tanto en esta pantalla
         que definirlo una vez evita veinte TextBlock con los mismos Setter.

         Sin BasedOn: el proyecto NO tiene un estilo implícito de TextBlock, y
         un BasedOn="{StaticResource {x:Type TextBlock}}" revienta la pantalla
         al abrirla con "resource not found". La fuente se pone a mano. -->
    <Style x:Key="Ficha.Etiqueta" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextoTerciario}" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="Ficha.Valor" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Fuente.Interfaz}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextoPrincipal}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Barra superior ===== -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Button DockPanel.Dock="Right" Content="Editar paciente"
              Style="{DynamicResource Boton.Primario}"
              Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding EditarCommand}" />
      <!-- La cita también se pone desde acá (pedido de la clínica 2026-08-27):
           cuando el paciente pide turno, la recepción está mirando su ficha, no
           la agenda. Lleva a Citas con el paciente ya elegido. -->
      <Button DockPanel.Dock="Right" Content="Agendar cita" Margin="0,0,10,0"
              Style="{DynamicResource Boton.Secundario}"
              Visibility="{Binding PuedeAgendar, Converter={StaticResource BoolAVisibilidad}}"
              Command="{Binding AgendarCitaCommand}" />
      <Button DockPanel.Dock="Right" Content="Actualizar" Margin="0,0,10,0"
              Style="{DynamicResource Boton.Secundario}"
              Command="{Binding RecargarCommand}" />
      <Button Content="◀  Volver a la lista" HorizontalAlignment="Left"
              Style="{DynamicResource Boton.Secundario}"
              Command="{Binding VolverCommand}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
      <StackPanel>

        <!-- ===== Datos del paciente ===== -->
        <Border Style="{DynamicResource Card}" Padding="24">
          <StackPanel>
            <TextBlock Text="{Binding Nombre}" Style="{DynamicResource Texto.Titulo2}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding RegistradoTexto}" Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}" Margin="0,4,0,20" />

            <!-- Tres columnas: los datos entran de un vistazo sin scrollear -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="CÉDULA" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding CedulaTexto}" Style="{StaticResource Ficha.Valor}"
                           FontFamily="{DynamicResource Fuente.Mono}" />
                <TextBlock Text="FECHA DE NACIMIENTO" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding NacimientoTexto}" Style="{StaticResource Ficha.Valor}" />
                <TextBlock Text="DIRECCIÓN" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding DireccionTexto}" Style="{StaticResource Ficha.Valor}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="TELÉFONO" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding TelefonoTexto}" Style="{StaticResource Ficha.Valor}" />
                <TextBlock Text="EDAD" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding EdadTexto}" Style="{StaticResource Ficha.Valor}" />
                <TextBlock Text="QUIÉN LO REFIRIÓ" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding ReferidorTexto}" Style="{StaticResource Ficha.Valor}" />
              </StackPanel>

              <StackPanel Grid.Column="4">
                <TextBlock Text="CORREO" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding EmailTexto}" Style="{StaticResource Ficha.Valor}" />
                <TextBlock Text="SEXO" Style="{StaticResource Ficha.Etiqueta}" />
                <TextBlock Text="{Binding SexoTexto}" Style="{StaticResource Ficha.Valor}" />
              </StackPanel>
            </Grid>

            <!-- Sin correo no sale el recordatorio: se avisa acá, que es donde
                 alguien está mirando la ficha y puede pedírselo al paciente. -->
            <Border Background="{DynamicResource Brush.PorVencer.Fondo}" CornerRadius="8"
                    Padding="12,9" Margin="0,0,0,14"
                    Visibility="{Binding SinEmail, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Este paciente no tiene correo cargado: no se le puede mandar el recordatorio de la cita."
                         TextWrapping="Wrap" FontSize="12.5"
                         Foreground="{DynamicResource Brush.PorVencer.Texto}" />
            </Border>

            <TextBlock Text="NOTAS DE RECEPCIÓN" Style="{StaticResource Ficha.Etiqueta}" />
            <TextBlock Text="{Binding NotasTexto}" Style="{StaticResource Ficha.Valor}" Margin="0" />
          </StackPanel>
        </Border>

        <!-- ===== Resumen ===== -->
        <Border Style="{DynamicResource Card}" Padding="24" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="ÚLTIMA VISITA" Style="{StaticResource Ficha.Etiqueta}" />
              <TextBlock Text="{Binding UltimaVisitaTexto}" Style="{DynamicResource Texto.Titulo3}" />
              <!-- Solo aparece si la fecha que manda es la cargada a mano: una
                   consulta migrada no vale lo mismo que una cita atendida, y
                   callarlo la haría pasar por dato del sistema. -->
              <TextBlock Text="{Binding OrigenUltimaVisitaTexto}" Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoTerciario}" Margin="0,2,0,0"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding ResumenCitasTexto}" Style="{DynamicResource Texto.Caption}"
                         Foreground="{DynamicResource Brush.TextoSecundario}" Margin="0,4,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="TOTAL FACTURADO" Style="{StaticResource Ficha.Etiqueta}" />
              <TextBlock Text="{Binding TotalFacturadoTexto}" Style="{DynamicResource Texto.Monto}" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="PAGÓ EL PACIENTE" Style="{StaticResource Ficha.Etiqueta}" />
              <TextBlock Text="{Binding TotalPagadoTexto}" Style="{DynamicResource Texto.Monto}" />
            </StackPanel>

            <StackPanel Grid.Column="3"
                        Visibility="{Binding MostrarArs, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="CUBRIÓ EL SEGURO" Style="{StaticResource Ficha.Etiqueta}" />
              <TextBlock Text="{Binding TotalArsTexto}" Style="{DynamicResource Texto.Monto}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===== Historial ===== -->
        <Border Style="{DynamicResource Card}" Padding="0" Margin="0,16,0,0">
          <TabControl Background="Transparent" BorderThickness="0" Padding="0,12,0,0">

            <TabItem Header="Citas">
              <Grid MinHeight="200">
                <TextBlock Text="Este paciente no tiene ninguna cita registrada."
                           Margin="24" Style="{DynamicResource Texto.Cuerpo}"
                           Foreground="{DynamicResource Brush.TextoSecundario}"
                           Visibility="{Binding SinCitas, Converter={StaticResource BoolAVisibilidad}}" />
                <DataGrid ItemsSource="{Binding Citas}" Style="{DynamicResource Tabla}"
                          MaxHeight="360"
                          Visibility="{Binding SinCitas, Converter={StaticResource InversorBoolVisibilidad}}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha y hora" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="180" />
                    <DataGridTextColumn Header="Médico" Binding="{Binding Medico}" Width="*" MinWidth="160"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoTexto}" Width="*" MinWidth="160"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Cobrada" Binding="{Binding CobradaTexto}" Width="Auto" MinWidth="90" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Procedimientos">
              <Grid MinHeight="200">
                <!-- Sale de lo FACTURADO, no de una nota médica: MED-100 no es
                     el expediente clínico (CLAUDE.md §1.1). -->
                <TextBlock Text="Todavía no se le cobró ningún procedimiento."
                           Margin="24" Style="{DynamicResource Texto.Cuerpo}"
                           Foreground="{DynamicResource Brush.TextoSecundario}"
                           Visibility="{Binding SinProcedimientos, Converter={StaticResource BoolAVisibilidad}}" />
                <DataGrid ItemsSource="{Binding Procedimientos}" Style="{DynamicResource Tabla}"
                          MaxHeight="360"
                          Visibility="{Binding SinProcedimientos, Converter={StaticResource InversorBoolVisibilidad}}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Procedimiento" Binding="{Binding Descripcion}"
                                        Width="*" MinWidth="200"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="Auto" MinWidth="70" />
                    <DataGridTextColumn Header="Médico" Binding="{Binding MedicoTexto}" Width="*" MinWidth="160"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Monto" Binding="{Binding MontoTexto}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="Factura" Binding="{Binding FacturaTexto}" Width="Auto" MinWidth="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Facturas">
              <Grid MinHeight="200">
                <TextBlock Text="Este paciente no tiene facturas."
                           Margin="24" Style="{DynamicResource Texto.Cuerpo}"
                           Foreground="{DynamicResource Brush.TextoSecundario}"
                           Visibility="{Binding SinFacturas, Converter={StaticResource BoolAVisibilidad}}" />
                <DataGrid ItemsSource="{Binding Facturas}" Style="{DynamicResource Tabla}"
                          MaxHeight="360"
                          Visibility="{Binding SinFacturas, Converter={StaticResource InversorBoolVisibilidad}}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="170" />
                    <DataGridTextColumn Header="Médico" Binding="{Binding MedicoTexto}" Width="*" MinWidth="150"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalTexto}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="Pagó" Binding="{Binding PacientePagaTexto}" Width="Auto" MinWidth="110" />
                    <DataGridTextColumn Header="Seguro" Binding="{Binding ArsTexto}" Width="Auto" MinWidth="180"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="NCF" Binding="{Binding NcfTexto}" Width="Auto" MinWidth="150" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="100">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Anulada}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Destructivo}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>

            <TabItem Header="Turnos de sala">
              <Grid MinHeight="200">
                <TextBlock Text="Nunca se le dio un turno de sala."
                           Margin="24" Style="{DynamicResource Texto.Cuerpo}"
                           Foreground="{DynamicResource Brush.TextoSecundario}"
                           Visibility="{Binding SinTurnos, Converter={StaticResource BoolAVisibilidad}}" />
                <DataGrid ItemsSource="{Binding Turnos}" Style="{DynamicResource Tabla}"
                          MaxHeight="360"
                          Visibility="{Binding SinTurnos, Converter={StaticResource InversorBoolVisibilidad}}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Turno" Binding="{Binding Etiqueta}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="120" />
                    <DataGridTextColumn Header="Llegó" Binding="{Binding HoraTexto}" Width="Auto" MinWidth="100" />
                    <DataGridTextColumn Header="Médico" Binding="{Binding MedicoTexto}" Width="*" MinWidth="180"
                                        HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
                    <DataGridTextColumn Header="Estado" Binding="{Binding EstadoTexto}" Width="Auto" MinWidth="120" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
