<UserControl x:Class="MED100.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== KPIs ===== -->
    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="VENTAS DE HOY" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding VentasHoy, Converter={StaticResource Money}}"
  Style="{DynamicResource Texto.Display}" />
          </Viewbox>
          <TextBlock Text="{Binding FacturasHoyTexto}" Style="{DynamicResource Texto.Caption}" />
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="VENTAS DEL MES" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding VentasMes, Converter={StaticResource Money}}"
  Style="{DynamicResource Texto.Display}" />
          </Viewbox>
          <TextBlock Text="{Binding VariacionTexto}">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Caption}">
                <Setter Property="Foreground" Value="{DynamicResource Brush.DeltaPositivo}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding VariacionPositiva}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.DeltaNegativo}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="TICKET PROMEDIO" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding TicketPromedio, Converter={StaticResource Money}}"
  Style="{DynamicResource Texto.Display}" />
          </Viewbox>
          <TextBlock Text="Por factura, este mes" Style="{DynamicResource Texto.Caption}" />
        </StackPanel>
      </Border>

      <Border Style="{DynamicResource Card.Metrica}">
        <StackPanel>
          <TextBlock Text="ALERTAS DE INVENTARIO" Style="{DynamicResource Texto.MicroLabel}" />
          <Viewbox Style="{DynamicResource Metrica.Valor}">
            <TextBlock Text="{Binding ProductosPorCaducar}" Style="{DynamicResource Texto.Display}" />
          </Viewbox>
          <TextBlock Text="{Binding AlertasInventarioTexto}" Style="{DynamicResource Texto.Caption}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- ===== Gráfico + rankings ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="20,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{Binding TituloGrafico}"
                     Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,12" />
          <lvc:CartesianChart Grid.Row="1"
                              Series="{Binding Series}"
                              XAxes="{Binding XAxes}"
                              YAxes="{Binding YAxes}" />
        </Grid>
      </Border>

      <!-- Top cajeros del mes -->
      <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="20,16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Top cajeros del mes"
                     Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,12" />
          <ItemsControl Grid.Row="1" ItemsSource="{Binding TopVendedores}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,10">
                  <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12"
                          Background="{DynamicResource Brush.PrimarioSutil}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Puesto}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primario}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                             Style="{DynamicResource Texto.Monto}"
                             Text="{Binding Total, Converter={StaticResource Money}}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Nombre}" Style="{DynamicResource Texto.CuerpoEnfatizado}" />
                    <TextBlock Text="{Binding FacturasTexto}" Style="{DynamicResource Texto.Caption}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Top productos ===== -->
    <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="20,16" Margin="0,16,0,0"
            MaxHeight="220">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Productos más vendidos del mes"
                   Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,10" />
        <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProductos}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Right" Width="120" TextAlignment="Right"
                           Style="{DynamicResource Texto.Monto}"
                           Text="{Binding Total, Converter={StaticResource Money}}" />
                <TextBlock DockPanel.Dock="Right" Width="120" TextAlignment="Right"
                           Style="{DynamicResource Texto.Caption}"
                           Text="{Binding UnidadesTexto}" />
                <TextBlock Text="{Binding Nombre}" Style="{DynamicResource Texto.Cuerpo}" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</UserControl>
