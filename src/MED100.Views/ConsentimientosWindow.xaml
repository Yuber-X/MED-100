<Window x:Class="MED100.Views.ConsentimientosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consentimiento informado"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ===== Encabezado ===== -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{Binding Encabezado}" Style="{DynamicResource Texto.Titulo3}" />
      <TextBlock Text="{Binding Explicacion}" Style="{DynamicResource Texto.Caption}"
                 TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ===== Lista de documentos ===== -->
      <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
        <DataGrid Style="{DynamicResource Tabla}"
                  ItemsSource="{Binding Lista}"
                  SelectedItem="{Binding Seleccionado}">
          <!-- El asomo del texto va de tooltip: en la lista solo entra el
               título, y dos consentimientos pueden llamarse casi igual. -->
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Setter Property="ToolTip" Value="{Binding Asomo}" />
            </Style>
          </DataGrid.RowStyle>

          <DataGrid.Columns>
            <DataGridTextColumn Header="Documento" Binding="{Binding Titulo}"
                                Width="*" MinWidth="170"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
            <DataGridTextColumn Header="Aplica a" Binding="{Binding Alcance}"
                                Width="Auto" MinWidth="150"
                                HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- ===== Texto / formulario ===== -->
      <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="18">
        <Grid>
          <!-- Lectura -->
          <Grid Visibility="{Binding Editando, Converter={StaticResource InversorBoolVisibilidad}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
              <TextBlock Text="{Binding Seleccionado.Titulo}" Style="{DynamicResource Texto.Titulo3}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding Seleccionado.Alcance}" Style="{DynamicResource Texto.Caption}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <!-- Solo lectura: el texto se cambia con "Editar", no de casualidad
                 mientras alguien lo lee para imprimirlo. -->
            <TextBox Grid.Row="1" Text="{Binding Seleccionado.Cuerpo, Mode=OneWay}"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Style="{DynamicResource Input.Texto}" Height="Auto" />

            <!-- Quién firma como médico. Opcional: si no se elige, la línea de
                 la firma sale en blanco igual. -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0"
                        Visibility="{Binding HayPaciente, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="Médico que lo va a firmar (opcional)" Style="{DynamicResource Input.Label}" />
              <ComboBox Height="38" FontSize="13" Margin="0,6,0,0"
                        DisplayMemberPath="Etiqueta"
                        ItemsSource="{Binding Medicos}"
                        SelectedItem="{Binding MedicoSeleccionado}" />
            </StackPanel>
          </Grid>

          <!-- Edición -->
          <Grid Visibility="{Binding Editando, Converter={StaticResource BoolAVisibilidad}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="Título" Style="{DynamicResource Input.Label}" />
              <TextBox Style="{DynamicResource Input.Texto}" Margin="0,6,0,0"
                       Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Cómo se llama el papel: «Consentimiento para extracción»" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,12,0,0">
              <TextBlock Text="Aplica a" Style="{DynamicResource Input.Label}" />
              <ComboBox Height="38" FontSize="13" Margin="0,6,0,0"
                        DisplayMemberPath="Etiqueta"
                        ItemsSource="{Binding Procedimientos}"
                        SelectedItem="{Binding ProcedimientoDelFormulario}" />
            </StackPanel>

            <CheckBox Grid.Row="2" Content="Activo (aparece para imprimir)" Margin="0,12,0,0"
                      IsChecked="{Binding Activo}" />

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <TextBlock Text="Texto que va a firmar el paciente" Style="{DynamicResource Input.Label}" />
              <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Text="Los datos del paciente, la fecha y las líneas de firma los pone el sistema: acá va solo el texto." />
              <TextBox Style="{DynamicResource Input.Texto}" Margin="0,6,0,0"
                       Height="240" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                       Text="{Binding Cuerpo, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,12,0,0">
              <Button Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                      Command="{Binding CancelarEdicionCommand}" />
              <Button Content="Guardar" Style="{DynamicResource Boton.Primario}" Margin="10,0,0,0"
                      Command="{Binding GuardarCommand}"
                      IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== Acciones ===== -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                  Visibility="{Binding PuedeEditar, Converter={StaticResource BoolAVisibilidad}}">
        <Button Content="Nuevo documento" Style="{DynamicResource Boton.Secundario}"
                Command="{Binding NuevoCommand}" />
        <Button Content="Editar" Style="{DynamicResource Boton.Secundario}" Margin="10,0,0,0"
                Command="{Binding EditarCommand}" IsEnabled="{Binding HaySeleccion}" />
        <Button Content="Dar de baja" Style="{DynamicResource Boton.Secundario}" Margin="10,0,0,0"
                Command="{Binding EliminarCommand}" IsEnabled="{Binding HaySeleccion}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cerrar" Style="{DynamicResource Boton.Secundario}"
                IsCancel="True" Click="BotonCerrar_Click" />
        <Button Content="Imprimir para firmar" Style="{DynamicResource Boton.Primario}"
                Margin="10,0,0,0"
                Command="{Binding ImprimirCommand}"
                IsEnabled="{Binding PuedeImprimir}"
                Visibility="{Binding HayPaciente, Converter={StaticResource BoolAVisibilidad}}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
