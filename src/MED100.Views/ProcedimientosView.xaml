<UserControl x:Class="MED100.Views.ProcedimientosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Nuevo procedimiento"
              Style="{DynamicResource Boton.Primario}"
              Command="{Binding NuevoCommand}" />
      <StackPanel>
        <TextBox Style="{DynamicResource Input.Texto}" Width="280" HorizontalAlignment="Left"
                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
        <TextBlock Text="{Binding Resumen}" Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoSecundario}" Margin="2,6,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
      <DataGrid ItemsSource="{Binding Procedimientos}"
                SelectedItem="{Binding Seleccionado}"
                Style="{DynamicResource Tabla}"
                AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="None">
        <DataGrid.Columns>
          <!-- Sin ElementStyle: el estilo "Tabla" ya aplica Tabla.Celda como
               CellStyle. Pasarlo acá reventaba, porque ElementStyle apunta al
               TextBlock de adentro y Tabla.Celda es TargetType="DataGridCell". -->
          <!-- Datos centrados bajo su encabezado, que también lo está
               (pedido 2026-08-14). El ElementStyle apunta al TextBlock de la
               celda; con CellStyle no funcionaría. -->
          <DataGridTextColumn Header="Código" Binding="{Binding CodigoTexto}" Width="Auto" MinWidth="90"
                              ElementStyle="{StaticResource Tabla.Texto.Centrado}" />
          <DataGridTextColumn Header="Procedimiento" Binding="{Binding Nombre}" Width="*" MinWidth="200"
                              ElementStyle="{StaticResource Tabla.Texto.Centrado}" />
          <DataGridTextColumn Header="Precio"
                              Binding="{Binding Precio, Converter={StaticResource Money}}" Width="Auto" MinWidth="120"
                              ElementStyle="{StaticResource Tabla.Texto.Centrado}" />
          <DataGridTextColumn Header="Duración" Binding="{Binding DuracionTexto}" Width="Auto" MinWidth="100"
                              ElementStyle="{StaticResource Tabla.Texto.Centrado}" />
          <!-- Se muestra para que un procedimiento gravado por error salte a la vista -->
          <DataGridTemplateColumn Header="ITBIS" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding ItbisTexto}" FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource Brush.PorVencer.Texto}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ExentoItbis}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource Brush.TextoSecundario}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Estado" Width="90">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="{DynamicResource Brush.Cancelado.Fondo}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Activo}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource Brush.AlDia.Fondo}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding EstadoTexto}" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Cancelado.Texto}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Activo}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AlDia.Texto}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
            Style="{DynamicResource Card}" Padding="20,20,8,20">
      <Grid>

        <!-- ===== Formulario ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                      Visibility="{Binding Editando, Converter={StaticResource BoolAVisibilidad}}">
          <StackPanel>
            <TextBlock Text="Procedimiento" Style="{DynamicResource Texto.Titulo3}" Margin="0,0,0,14" />

            <TextBlock Text="Nombre" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Código (opcional)" Style="{DynamicResource Input.Label}" Margin="0,12,0,6" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Precio (RD$)" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Duración (min)" Style="{DynamicResource Input.Label}" />
                <TextBox Style="{DynamicResource Input.Texto}"
                         Text="{Binding DuracionTexto, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="La duración es lo que ocupa en la agenda del médico."
                       Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoTerciario}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="Descripción (opcional)" Style="{DynamicResource Input.Label}" Margin="0,12,0,6" />
            <TextBox Style="{DynamicResource Input.Texto}" Height="64"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" Padding="10,8"
                     Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" />

            <!-- La casilla de ITBIS salió de acá (pedido de Yuber 2026-08-14):
                 el impuesto se prende y se apaga una sola vez, en Configuración,
                 y no procedimiento por procedimiento. Los servicios de salud
                 van exentos siempre; el ITBIS sale de los insumos. -->
            <Border Background="{DynamicResource Brush.FondoEncabezadoTabla}" CornerRadius="8"
                    Padding="12,10" Margin="0,14,0,0">
              <TextBlock TextWrapping="Wrap" FontSize="12.5"
                         Foreground="{DynamicResource Brush.TextoSecundario}"
                         Text="Los procedimientos van exentos de ITBIS: en el país los servicios de salud no pagan el impuesto. El ITBIS sale de los insumos, y se prende o se apaga en Configuración → Cálculos e impuestos." />
            </Border>

            <CheckBox Content="Activo (se puede cobrar y agendar)" Margin="0,14,0,0"
                      IsChecked="{Binding Activo}" />

            <TextBlock Text="{Binding MensajeError}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource Brush.Destructivo}"
                       Style="{DynamicResource Texto.Caption}" />

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                      Command="{Binding CancelarCommand}" />
              <Button Grid.Column="2" Content="Guardar" Style="{DynamicResource Boton.Primario}"
                      Command="{Binding GuardarCommand}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Ficha ===== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"
                      Visibility="{Binding Editando, Converter={StaticResource InversorBoolVisibilidad}}">
          <StackPanel>
            <TextBlock Text="Elegí un procedimiento de la lista para editarlo."
                       TextWrapping="Wrap" Style="{DynamicResource Texto.Cuerpo}"
                       Foreground="{DynamicResource Brush.TextoSecundario}"
                       Visibility="{Binding HaySeleccion,
                                    Converter={StaticResource InversorBoolVisibilidad}}" />

            <StackPanel Visibility="{Binding HaySeleccion, Converter={StaticResource BoolAVisibilidad}}">
              <TextBlock Text="{Binding Seleccionado.Nombre}" TextWrapping="Wrap"
                         Style="{DynamicResource Texto.Titulo3}" />
              <TextBlock Text="{Binding Seleccionado.Precio, Converter={StaticResource Money}}"
                         Style="{DynamicResource Texto.Monto}" Margin="0,6,0,0" />

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{Binding Seleccionado.DuracionTexto}"
                           Style="{DynamicResource Texto.Caption}"
                           Foreground="{DynamicResource Brush.TextoSecundario}" />
                <TextBlock Text="  ·  " Style="{DynamicResource Texto.Caption}"
                           Foreground="{DynamicResource Brush.TextoTerciario}" />
                <TextBlock Text="{Binding Seleccionado.ItbisTexto}"
                           Style="{DynamicResource Texto.Caption}"
                           Foreground="{DynamicResource Brush.TextoSecundario}" />
                <TextBlock Text="  ·  " Style="{DynamicResource Texto.Caption}"
                           Foreground="{DynamicResource Brush.TextoTerciario}" />
                <TextBlock Text="{Binding Seleccionado.EstadoTexto}"
                           Style="{DynamicResource Texto.Caption}"
                           Foreground="{DynamicResource Brush.TextoSecundario}" />
              </StackPanel>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Editar" Style="{DynamicResource Boton.Secundario}"
                        Command="{Binding EditarCommand}" />
                <Button Grid.Column="2" Content="Eliminar" Style="{DynamicResource Boton.Destructivo}"
                        Command="{Binding EliminarCommand}" />
              </Grid>

              <!-- ===== Agendar este procedimiento =====
                   Los dos combos que pidió Yuber (paciente y médico) van acá,
                   en la ficha, y no en el alta del procedimiento: el tarifario
                   es un catálogo de precios y no tiene dueño. Lo que se crea es
                   una CITA, que es donde sí viven juntos paciente, médico y
                   procedimiento. -->
              <Button Content="Agendar a un paciente" Margin="0,12,0,0"
                      Style="{DynamicResource Boton.Primario}"
                      Command="{Binding AbrirAgendaCommand}"
                      Visibility="{Binding Agendando,
                                   Converter={StaticResource InversorBoolVisibilidad}}" />

              <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="10"
                      Padding="14" Margin="0,14,0,0"
                      Visibility="{Binding Agendando, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                  <TextBlock Text="AGENDAR ESTE PROCEDIMIENTO"
                             Style="{DynamicResource Texto.MicroLabel}" />

                  <TextBlock Text="Paciente" Style="{DynamicResource Input.Label}" Margin="0,10,0,6" />
                  <TextBox Style="{DynamicResource Input.Texto}"
                           Text="{Binding BusquedaPaciente, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                           ToolTip="Escribí nombre, cédula o teléfono para acotar la lista" />
                  <ComboBox Margin="0,8,0,0"
                            ItemsSource="{Binding PacientesSugeridos}"
                            SelectedItem="{Binding PacienteAgenda, Mode=TwoWay}"
                            ItemTemplate="{DynamicResource Combo.Nombre}" />
                  <TextBlock Text="{Binding MensajePacientes}" TextWrapping="Wrap"
                             Style="{DynamicResource Texto.Caption}"
                             Foreground="{DynamicResource Brush.TextoTerciario}" Margin="2,4,0,0" />

                  <TextBlock Text="Día" Style="{DynamicResource Input.Label}" Margin="0,12,0,6" />
                  <DatePicker SelectedDate="{Binding DiaAgenda, Mode=TwoWay}" />

                  <TextBlock Text="Médico" Style="{DynamicResource Input.Label}" Margin="0,12,0,6" />
                  <ComboBox ItemsSource="{Binding MedicosAgenda}"
                            SelectedItem="{Binding MedicoAgenda, Mode=TwoWay}"
                            ItemTemplate="{DynamicResource Combo.Nombre}" />

                  <TextBlock Text="Hora disponible" Style="{DynamicResource Input.Label}" Margin="0,12,0,6" />
                  <ComboBox ItemsSource="{Binding HuecosAgenda}"
                            SelectedItem="{Binding HuecoAgenda, Mode=TwoWay}"
                            ItemTemplate="{DynamicResource Combo.HoraTexto}" />

                  <TextBlock Text="{Binding MensajeAgenda}" TextWrapping="Wrap" Margin="2,10,0,0"
                             Foreground="{DynamicResource Brush.Destructivo}"
                             Style="{DynamicResource Texto.Caption}" />

                  <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar"
                            Style="{DynamicResource Boton.Secundario}"
                            Command="{Binding CerrarAgendaCommand}" />
                    <Button Grid.Column="2" Content="Crear cita"
                            Style="{DynamicResource Boton.Primario}"
                            Command="{Binding AgendarCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
