<UserControl x:Class="MED100.Views.IndicacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Margin="24">
    <!-- Sin permiso la pantalla no muestra nada y lo dice. Es contenido
         clínico: mejor una pantalla explícitamente vacía que un error. -->
    <Border Style="{DynamicResource Card}" Padding="24" VerticalAlignment="Top"
            Visibility="{Binding PuedeRegistrar, Converter={StaticResource InversorBoolVisibilidad}}">
      <StackPanel>
        <TextBlock Text="Medicamentos indicados" Style="{DynamicResource Texto.Titulo3}" />
        <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="No tenés permiso para ver los medicamentos indicados. Es información de salud del paciente y por eso está restringida. Si necesitás acceso, pediselo a un administrador." />
      </StackPanel>
    </Border>

    <Grid Visibility="{Binding PuedeRegistrar, Converter={StaticResource BoolAVisibilidad}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="420" />
      </Grid.ColumnDefinitions>

      <!-- ===== Día ===== -->
      <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Style="{DynamicResource Card}" Padding="20" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Día" Style="{DynamicResource Input.Label}"
                     VerticalAlignment="Center" Margin="0,0,10,0" />
          <DatePicker SelectedDate="{Binding Dia}" Width="160" Height="36" FontSize="13" />
          <Button Content="Hoy" Style="{DynamicResource Boton.Secundario}"
                  Margin="10,0,0,0" Command="{Binding IrAHoyCommand}" />
          <TextBlock Text="Estás mirando un día pasado: se puede consultar, no cargar."
                     Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.PorVencer.Texto}"
                     VerticalAlignment="Center" Margin="16,0,0,0"
                     Visibility="{Binding EsDiaPasado, Converter={StaticResource BoolAVisibilidad}}" />
        </StackPanel>
      </Border>

      <!-- ===== Lo indicado ese día ===== -->
      <Border Grid.Row="1" Grid.Column="0" Style="{DynamicResource Card}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DataGrid Grid.Row="0" ItemsSource="{Binding DelDia}"
                    SelectedItem="{Binding Seleccionada}"
                    AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    CanUserResizeRows="False" SelectionMode="Single"
                    RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Paciente" Binding="{Binding ClienteNombre}" Width="180" />
              <DataGridTextColumn Header="Médico" Binding="{Binding MedicoNombre}" Width="150" />
              <DataGridTextColumn Header="Medicamentos" Binding="{Binding ResumenMedicamentos}" Width="*" />
              <DataGridTextColumn Header="Cargó" Binding="{Binding UsuarioNombre}" Width="130" />
            </DataGrid.Columns>

            <!-- El detalle completo se abre al seleccionar: en la fila solo
                 caben los nombres, y la dosis es justo lo que hay que leer
                 cuando el paciente vuelve a preguntar. -->
            <DataGrid.RowDetailsTemplate>
              <DataTemplate>
                <StackPanel Margin="16,8,16,12">
                  <ItemsControl ItemsSource="{Binding Medicamentos}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" Margin="0,2"
                                   Style="{DynamicResource Texto.Cuerpo}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Notas}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Style="{DynamicResource Texto.Caption}" />
                </StackPanel>
              </DataTemplate>
            </DataGrid.RowDetailsTemplate>
          </DataGrid>

          <!-- Dar de baja es solo del Admin: corregir lo que consta que se le
               indicó a un paciente no es una operación de mostrador. -->
          <Button Grid.Row="1" Content="Dar de baja lo seleccionado"
                  Style="{DynamicResource Boton.Secundario}"
                  HorizontalAlignment="Left" Margin="16,0,16,16"
                  Command="{Binding EliminarCommand}"
                  IsEnabled="{Binding HaySeleccion}"
                  Visibility="{Binding EsAdmin, Converter={StaticResource BoolAVisibilidad}}" />
        </Grid>
      </Border>

      <!-- ===== Cargar ===== -->
      <Border Grid.Row="1" Grid.Column="2" Style="{DynamicResource Card}" Padding="20"
              VerticalAlignment="Top"
              Visibility="{Binding PuedeCargar, Converter={StaticResource BoolAVisibilidad}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
          <StackPanel>
            <TextBlock Text="Anotar lo indicado" Style="{DynamicResource Texto.Titulo3}" />
            <TextBlock Style="{DynamicResource Texto.Caption}" TextWrapping="Wrap" Margin="0,4,0,14"
                       Text="Se anota QUÉ le mandó a tomar el médico. No es un expediente clínico: acá no va el diagnóstico ni el motivo." />

            <TextBlock Text="Paciente" Style="{DynamicResource Input.Label}" />
            <ComboBox Height="40" FontSize="13" Margin="0,6,0,0"
                      IsEditable="True" IsTextSearchEnabled="True"
                      DisplayMemberPath="Etiqueta"
                      ItemsSource="{Binding Pacientes}"
                      SelectedItem="{Binding PacienteSeleccionado}" />

            <TextBlock Text="Médico que lo indicó" Style="{DynamicResource Input.Label}" Margin="0,12,0,0" />
            <ComboBox Height="40" FontSize="13" Margin="0,6,0,0"
                      DisplayMemberPath="Etiqueta"
                      ItemsSource="{Binding Medicos}"
                      SelectedItem="{Binding MedicoSeleccionado}" />

            <TextBlock Text="Medicamentos" Style="{DynamicResource Input.Label}" Margin="0,16,0,0" />
            <ItemsControl ItemsSource="{Binding Renglones}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource Brush.BordeSutil}" BorderThickness="1"
                          CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBox Style="{DynamicResource Input.Texto}"
                               Text="{Binding Medicamento, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="Nombre del medicamento. Es lo único obligatorio." />
                      <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="6" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{DynamicResource Input.Texto}"
                                 Text="{Binding Dosis, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Dosis: 500 mg, 1 tableta…" />
                        <TextBox Grid.Column="2" Style="{DynamicResource Input.Texto}"
                                 Text="{Binding Frecuencia, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Frecuencia: cada 8 horas…" />
                        <TextBox Grid.Column="4" Style="{DynamicResource Input.Texto}"
                                 Text="{Binding Duracion, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Duración: por 7 días…" />
                      </Grid>
                      <TextBox Style="{DynamicResource Input.Texto}" Margin="0,6,0,0"
                               Text="{Binding Instrucciones, UpdateSourceTrigger=PropertyChanged}"
                               ToolTip="Instrucciones: con comida, no manejar…" />
                      <Button Content="Quitar" Style="{DynamicResource Boton.Secundario}"
                              HorizontalAlignment="Right" Margin="0,6,0,0"
                              Command="{Binding DataContext.QuitarRenglonCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Agregar otro medicamento" Style="{DynamicResource Boton.Secundario}"
                    HorizontalAlignment="Left" Command="{Binding AgregarRenglonCommand}" />

            <TextBlock Text="Nota (opcional)" Style="{DynamicResource Input.Label}" Margin="0,14,0,0" />
            <TextBox Style="{DynamicResource Input.Texto}" Margin="0,6,0,0"
                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top"
                     Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="Guardar" Style="{DynamicResource Boton.Primario}"
                    Margin="0,16,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding GuardarCommand}"
                    IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
