<UserControl x:Class="MED100.Views.CaducidadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Resumen de urgencias.
         Son los dos únicos indicadores de la pantalla, así que van al centro y
         en grande (pedido de Yuber 2026-07-31): con el ancho de una tarjeta
         suelta a la izquierda quedaban perdidos. -->
    <UniformGrid Grid.Row="0" Columns="2" Margin="0,8,0,20" MaxWidth="820"
                 HorizontalAlignment="Center">
      <Border Style="{DynamicResource Card.Metrica}" Margin="0,0,18,0" MinHeight="150">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="CRÍTICOS (1 MES O MENOS)" Style="{DynamicResource Texto.MicroLabel}"
                     HorizontalAlignment="Center" />
          <Viewbox MaxHeight="86" Margin="0,10,0,0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding TotalRojos}" Style="{DynamicResource Texto.Display}"
                       Foreground="{DynamicResource Brush.Destructivo}" />
          </Viewbox>
        </StackPanel>
      </Border>
      <Border Style="{DynamicResource Card.Metrica}" MinHeight="150">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="PRÓXIMOS (2–3 MESES)" Style="{DynamicResource Texto.MicroLabel}"
                     HorizontalAlignment="Center" />
          <Viewbox MaxHeight="86" Margin="0,10,0,0" HorizontalAlignment="Center">
            <TextBlock Text="{Binding TotalNaranjas}" Style="{DynamicResource Texto.Display}" />
          </Viewbox>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Ordenado por proximidad; los más urgentes arriba -->
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Código" Binding="{Binding CodigoTexto}" Width="Auto" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="150"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Stock" Binding="{Binding Cantidad}" Width="Auto" MinWidth="90">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Caducidad" Binding="{Binding CaducidadTexto}" Width="Auto" MinWidth="120">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Tiempo restante" Width="140"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Pill.Caducidad}" HorizontalAlignment="Left">
                  <TextBlock Style="{DynamicResource Pill.Caducidad.Texto}"
                             Text="{Binding SemaforoTexto}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding ContadorTexto}"
               Style="{DynamicResource Texto.Caption}" Margin="4,10,0,0" />
  </Grid>
</UserControl>
