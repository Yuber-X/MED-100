<Window x:Class="MED100.Views.ActivacionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:MED100.Common;assembly=MED100.Common"
        Title="{Binding Source={x:Static common:AppInfo.Nombre}, StringFormat={}{0} — Activación}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/MED100.Views;component/Assets/med100.ico"
        Background="{DynamicResource Brush.FondoApp}">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
  </Window.Resources>

  <Grid>
    <Border Style="{DynamicResource Card}" Width="400" VerticalAlignment="Center"
            Padding="32" Margin="0,32">
      <StackPanel>

        <!-- Encabezado: la misma cruz del menú, para que se vea que es MED-100
             y no un cartel raro de Windows -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
          <Border Width="28" Height="28" CornerRadius="8"
                  Background="{DynamicResource Brush.Primario}">
            <Path Fill="White" Stretch="Uniform" Width="14" Height="14"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 6,0 H 10 V 6 H 16 V 10 H 10 V 16 H 6 V 10 H 0 V 6 H 6 Z" />
          </Border>
          <TextBlock Text="{x:Static common:AppInfo.Nombre}" Style="{DynamicResource Texto.Titulo3}"
                     VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock Text="{Binding Titulo}" Style="{DynamicResource Texto.Titulo3}"
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Explicacion}" Style="{DynamicResource Texto.Caption}"
                   TextWrapping="Wrap" Margin="0,0,0,20" />

        <!-- Código: no aparece si ya está activado -->
        <StackPanel Visibility="{Binding PideCodigo, Converter={StaticResource BoolAVisibilidad}}">
          <TextBlock Text="Llave del producto" Style="{DynamicResource Input.Label}" />
          <TextBox x:Name="CajaCodigo" Style="{DynamicResource Input.Texto}"
                   Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="Consolas" FontSize="16"
                   CharacterCasing="Upper"
                   MaxLength="30"
                   KeyDown="CajaCodigo_KeyDown" />
          <TextBlock Text="Se escribe tal cual viene: MED1-XXXXX-XXXXX-XXXXX"
                     Style="{DynamicResource Texto.Caption}" Margin="0,6,0,0" />

          <TextBlock Text="{Binding MensajeError}"
                     Style="{DynamicResource Texto.Caption}"
                     Foreground="{DynamicResource Brush.Destructivo}"
                     TextWrapping="Wrap" Margin="0,10,0,0" />

          <Button Content="Activar" Style="{DynamicResource Boton.Primario}"
                  Margin="0,16,0,0"
                  IsDefault="True"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}"
                  Command="{Binding ActivarCommand}" />
        </StackPanel>

        <!-- Salidas. Cuál se ve depende de si todavía quedan días de prueba. -->
        <Button Content="Seguir en modo de prueba"
                Style="{DynamicResource Boton.Secundario}" Margin="0,10,0,0"
                Visibility="{Binding EsBloqueante, Converter={StaticResource InversorBoolVisibilidad}}"
                Command="{Binding ContinuarCommand}" />
        <Button Content="{Binding Source={x:Static common:AppInfo.Nombre}, StringFormat=Cerrar {0}}"
                Style="{DynamicResource Boton.Secundario}" Margin="0,10,0,0"
                Visibility="{Binding EsBloqueante, Converter={StaticResource BoolAVisibilidad}}"
                Command="{Binding SalirCommand}" />

        <Border Background="{DynamicResource Brush.PrimarioSutil}" CornerRadius="8"
                Padding="14" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="{Binding TextoSoporte}" Style="{DynamicResource Texto.Caption}"
                       TextWrapping="Wrap" />
            <Button Content="Escribir por WhatsApp"
                    Style="{DynamicResource Boton.Terciario}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="BotonWhatsApp_Click" />
          </StackPanel>
        </Border>

      </StackPanel>
    </Border>
  </Grid>
</Window>
