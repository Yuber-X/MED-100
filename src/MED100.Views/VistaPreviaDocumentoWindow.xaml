<Window x:Class="MED100.Views.VistaPreviaDocumentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa"
        Width="900" Height="820"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.FondoApp}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- FlowDocumentPageViewer y no ScrollViewer: el documento pagina, y hay
         que poder ver la hoja 2 antes de mandarla a imprimir. -->
    <Border Grid.Row="0" Background="White"
            BorderBrush="{DynamicResource Brush.BordeEstandar}" BorderThickness="1">
      <FlowDocumentPageViewer x:Name="Visor" Background="White" />
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="Cerrar" Style="{DynamicResource Boton.Secundario}"
              IsCancel="True" Click="BotonCerrar_Click" />
      <Button Grid.Column="2" Content="Imprimir" Style="{DynamicResource Boton.Primario}"
              Click="BotonImprimir_Click" />
    </Grid>
  </Grid>
</Window>
