<UserControl x:Class="MED100.Views.ClienteFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Formulario centrado, ancho máximo 640 (DESIGN.md §9) -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
    <Border Style="{DynamicResource Card}" MaxWidth="640" VerticalAlignment="Top"
            HorizontalAlignment="Center" Padding="32" Margin="0,8">
      <StackPanel>
        <TextBlock Text="{Binding Titulo}" Style="{DynamicResource Texto.Titulo2}"
                   Margin="0,0,0,20" />

        <TextBlock Text="Nombre completo" Style="{DynamicResource Input.Label}" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Cédula (opcional)" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Cedula, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="001-1234567-8 (o pasaporte). Puede quedar vacía." />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Teléfono" Style="{DynamicResource Input.Label}" />
            <TextBox Style="{DynamicResource Input.Texto}"
                     Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <!-- El correo no es decorativo: por acá sale el recordatorio de cita -->
        <TextBlock Text="Correo electrónico" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Sin correo no se le puede mandar el recordatorio de la cita."
                   Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoTerciario}"
                   TextWrapping="Wrap" Margin="2,4,0,0" />

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Fecha de nacimiento" Style="{DynamicResource Input.Label}" />
            <DatePicker SelectedDate="{Binding FechaNacimiento, Mode=TwoWay}" />
            <!-- La edad en vivo es la comprobación del dedazo en el año -->
            <TextBlock Text="{Binding EdadTexto}" Style="{DynamicResource Texto.Caption}"
                       Foreground="{DynamicResource Brush.TextoSecundario}" Margin="2,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Sexo" Style="{DynamicResource Input.Label}" />
            <!-- ItemTemplate y NO DisplayMemberPath: con el template propio del
                 ComboBox, DisplayMemberPath dejaba la caja cerrada mostrando el
                 ToString() del record ("OpcionSexo { Valor = … }"). -->
            <ComboBox ItemsSource="{Binding OpcionesSexo}"
                      SelectedItem="{Binding SexoSeleccionado, Mode=TwoWay}"
                      ItemTemplate="{DynamicResource Combo.Etiqueta}" />
          </StackPanel>
        </Grid>

        <!-- ===== Procedencia: "registro de proveniento" ===== -->
        <TextBlock Text="¿Quién lo refirió?" Style="{DynamicResource Input.Label}" Margin="0,18,0,6" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0" ItemsSource="{Binding TiposReferidor}"
                    SelectedItem="{Binding TipoReferidorSeleccionado, Mode=TwoWay}"
                    ItemTemplate="{DynamicResource Combo.Etiqueta}" />
          <!-- Editable a propósito: al elegir "médico" o "ARS" la lista trae los
               que ya están cargados en la clínica, pero se puede escribir uno
               que no esté (un médico de afuera) y se crea al guardar. -->
          <ComboBox Grid.Column="2" IsEditable="True" IsTextSearchEnabled="True"
                    ItemsSource="{Binding SugerenciasReferidor}"
                    Text="{Binding ReferidorNombre, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock TextWrapping="Wrap" Margin="2,6,0,0"
                   Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoTerciario}"
                   Text="{Binding AyudaReferidor}" />

        <TextBlock Text="Dirección" Style="{DynamicResource Input.Label}" Margin="0,18,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}"
                 Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" />

        <!-- Fecha retroactiva de consulta (pedido de la clínica 2026-08-27).
             Solo hace falta al cargar pacientes viejos: para el que se registra
             hoy y viene hoy, el sistema la deduce solo. -->
        <TextBlock Text="Última visita (antes del sistema)" Style="{DynamicResource Input.Label}"
                   Margin="0,18,0,6" />
        <DatePicker SelectedDate="{Binding UltimaVisitaPrevia, Mode=TwoWay}"
                    DisplayDateEnd="{Binding UltimoDiaVisitable}" />
        <TextBlock TextWrapping="Wrap" Margin="2,4,0,0"
                   Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoTerciario}"
                   Text="Solo para pacientes que ya venían a la clínica antes de usar el sistema: cuándo fue su última consulta. Sirve para que aparezcan en el aviso de los que dejaron de venir. Si tiene citas o facturas más recientes, manda la del sistema." />

        <TextBlock Text="Notas" Style="{DynamicResource Input.Label}" Margin="0,14,0,6" />
        <TextBox Style="{DynamicResource Input.Texto}" Height="72"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalContentAlignment="Top" Padding="10,8"
                 Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock TextWrapping="Wrap" Margin="2,4,0,0"
                   Style="{DynamicResource Texto.Caption}"
                   Foreground="{DynamicResource Brush.TextoTerciario}"
                   Text="Notas de recepción («prefiere turno en la tarde»). Acá NO van diagnósticos ni tratamientos." />

        <TextBlock Text="{Binding MensajeError}"
                   Foreground="{DynamicResource Brush.Destructivo}"
                   Style="{DynamicResource Texto.Caption}"
                   TextWrapping="Wrap" Margin="0,12,0,0" />

        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Cancelar" Style="{DynamicResource Boton.Secundario}"
                  Command="{Binding CancelarCommand}" />
          <Button Grid.Column="2" Content="Guardar paciente" Style="{DynamicResource Boton.Primario}"
                  Command="{Binding GuardarCommand}"
                  IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
