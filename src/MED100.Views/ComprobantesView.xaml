<UserControl x:Class="MED100.Views.ComprobantesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Filtros -->
    <Border Grid.Row="0" Style="{DynamicResource Card}" Padding="16" Margin="0,0,0,16">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Width="260" Margin="0,0,0,4">
          <TextBlock Text="Número de factura o cliente" Style="{DynamicResource Input.Label}" />
          <TextBox Style="{DynamicResource Input.Texto}"
                   Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Margin="12,0,0,0">
          <TextBlock Text="Desde" Style="{DynamicResource Input.Label}" />
          <DatePicker Width="150" Height="40" FontSize="13" SelectedDate="{Binding Desde}" />
        </StackPanel>
        <StackPanel Margin="12,0,0,0">
          <TextBlock Text="Hasta" Style="{DynamicResource Input.Label}" />
          <DatePicker Width="150" Height="40" FontSize="13" SelectedDate="{Binding Hasta}" />
        </StackPanel>
        <Button Content="Buscar" Style="{DynamicResource Boton.Primario}"
                VerticalAlignment="Bottom" Margin="12,0,0,0"
                Command="{Binding BuscarCommand}"
                IsEnabled="{Binding Ocupado, Converter={StaticResource InversorBool}}" />
      </WrapPanel>
    </Border>

    <!-- Resultados -->
    <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="0">
      <DataGrid Style="{DynamicResource Tabla}" ItemsSource="{Binding Filas}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Factura" Binding="{Binding Numero}" Width="Auto" MinWidth="110">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{DynamicResource Fuente.Mono}" />
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="Auto" MinWidth="150" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteTexto}" Width="Auto" MinWidth="160"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Cajero" Binding="{Binding Cajero}" Width="Auto" MinWidth="130"
                              HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}" />
          <DataGridTextColumn Header="Pago" Binding="{Binding MetodoTexto}" Width="Auto" MinWidth="100" />
          <DataGridTextColumn Header="Total"
                              Binding="{Binding Total, Converter={StaticResource Money}}" Width="Auto" MinWidth="130">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Texto.Monto}" />
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTemplateColumn Header="Estado" Width="110"
                                  HeaderStyle="{StaticResource Tabla.Encabezado.Izquierda}">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Style="{DynamicResource Pill.EstadoFactura}" HorizontalAlignment="Left">
                  <TextBlock Style="{DynamicResource Pill.EstadoFactura.Texto}"
                             Text="{Binding EstadoTexto}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="380">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="Reimprimir" Style="{DynamicResource Boton.Terciario}"
                          Command="{Binding DataContext.ReimprimirCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                  <!-- Guardar el PDF en el expediente. Está para las facturas
                       ANTERIORES al archivado automático (2026-08-15): las
                       nuevas ya se archivan solas al emitirse. Solo aparece si
                       la factura tiene paciente y el usuario puede tocar
                       expedientes (el Cajero no). -->
                  <Button Content="Al expediente" Margin="8,0,0,0"
                          ToolTip="Guarda una copia en PDF de este comprobante en el expediente del paciente"
                          Command="{Binding DataContext.ArchivarCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Boton.Terciario}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding TienePaciente}" Value="True" />
                              <Condition Binding="{Binding DataContext.PuedeArchivar,
                                                   RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                         Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <!-- Anular: solo con permiso y si no está ya anulada -->
                  <Button Content="Anular"
                          Foreground="{DynamicResource Brush.Destructivo}" Margin="8,0,0,0"
                          Command="{Binding DataContext.AnularCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Boton.Terciario}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EstaAnulada}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding DataContext.PuedeAnular,
                                       RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <DockPanel Grid.Row="2" Margin="4,10,0,0">
      <TextBlock DockPanel.Dock="Right" Text="{Binding AlcanceTexto}"
                 Style="{DynamicResource Texto.Caption}" />
      <TextBlock Text="{Binding ContadorTexto}" Style="{DynamicResource Texto.Caption}" />
    </DockPanel>
  </Grid>
</UserControl>
