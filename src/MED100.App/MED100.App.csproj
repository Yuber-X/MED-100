<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MED100.Views\MED100.Views.csproj" />
    <ProjectReference Include="..\MED100.ViewModels\MED100.ViewModels.csproj" />
    <ProjectReference Include="..\MED100.Services\MED100.Services.csproj" />
    <ProjectReference Include="..\MED100.Data\MED100.Data.csproj" />
    <ProjectReference Include="..\MED100.Common\MED100.Common.csproj" />
    <ProjectReference Include="..\MED100.Printing\MED100.Printing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!-- Versión del producto. TIENE que coincidir con MED100.Common.AppInfo.Version
       y con AppVersion en installer/MED100.iss.

       No es cosmético: el actualizador lee la versión del .exe que quedó en
       disco y la compara con la que traía. Si el ejecutable no llevara versión,
       esa comprobación no podría hacerse y volveríamos al problema del
       2026-09-05 en FAControl — el asistente diciendo "listo" mientras la
       aplicación seguía siendo la vieja. -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <Product>Odonto Unión</Product>
    <Company>Yuber Santana</Company>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Ícono del ejecutable: tienda (Explorer, barra de tareas, ventanas) -->
    <ApplicationIcon>Assets\med100.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
