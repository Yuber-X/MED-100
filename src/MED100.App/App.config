<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Reemplazar CAMBIAR_USUARIO y CAMBIAR_PASSWORD por las credenciales
      locales de MySQL. En la máquina del cliente esta cadena se ajusta
      durante la instalación (usuario dedicado 'med100', nunca root):
      ver docs/INSTALL.md, paso 5.
    -->
    <add name="MED100Db"
         connectionString="Server=localhost;Port=3306;Database=med100_db;Uid=CAMBIAR_USUARIO;Pwd=CAMBIAR_PASSWORD;" />
  </connectionStrings>
</configuration>
